"""
Bronze layer for the Victoria Bluetooth Travel Time project (Databricks).

This is intentionally written in a “class-style ETL” similar to your reference example.

Current recommended ingestion for Databricks Free Edition:
- You upload your local `.jsonl` dump file and create a table like:
    workspace.default.traffic_raw_file_bronze
- Then this Bronze job reads that table as a stream and upserts into a canonical:
    workspace.default.traffic_bronze

Later (optional), you can swap the source to Kafka/Confluent Cloud.
"""

from pyspark.sql import functions as F


class TrafficBronze:
    def __init__(
        self,
        *,
        source_table: str = "workspace.default.traffic_raw_file_bronze",
        bronze_table: str = "workspace.default.traffic_bronze",
        checkpoint: str = "/tmp/checkpoints/traffic_bronze",
    ) -> None:
        self.source_table = source_table
        self.bronze_table = bronze_table
        self.checkpoint = checkpoint

    def ingestFromSourceTable(self):
        """
        Stream from a Delta table (created from uploaded JSONL).
        This lets you practice Structured Streaming without needing Kafka connectivity yet.
        """
        return spark.readStream.table(self.source_table)

    def normalize(self, df):
        """
        Keep the raw-ish columns plus the parsed JSON object.

        Your uploaded table already has:
          - key (Kafka key from dump)
          - topic/partition/offset/timestamp (Kafka metadata from dump)
          - value (raw JSON string)
          - value_json (parsed JSON object)
          - dumped_at (when the consumer wrote it)
        """
        return (
            df.select(
                F.col("topic").cast("string").alias("topic"),
                F.col("partition").cast("int").alias("partition"),
                F.col("offset").cast("long").alias("offset"),
                F.col("timestamp").alias("kafka_timestamp_raw"),
                F.col("key").cast("string").alias("kafka_key"),
                F.col("value").cast("string").alias("value_str"),
                F.col("value_json").alias("value_json"),
                F.col("dumped_at").alias("dumped_at"),
            )
            # Useful derived columns for downstream
            .withColumn("ingested_at", F.to_timestamp(F.get_json_object("value_str", "$.ingested_at")))
            .withColumn("link_id", F.col("value_json.payload.id").cast("int"))
            .withColumn("road_name", F.col("value_json.payload.name").cast("string"))
            .withColumn(
                "interval_start",
                F.to_timestamp(F.col("value_json.payload.latest_stats.interval_start")),
            )
        )

    def _ensure_target_table(self, batch_df):
        if not spark.catalog.tableExists(self.bronze_table):
            (
                batch_df.limit(0)
                .write.format("delta")
                .mode("overwrite")
                .saveAsTable(self.bronze_table)
            )

    def upsert(self, batch_df, batch_id):
        """
        Deduplicate / upsert using Kafka identity: (topic, partition, offset).
        That key is stable within a topic partition.
        """
        self._ensure_target_table(batch_df)
        batch_df.createOrReplaceTempView("traffic_bronze_batch")
        spark.sql(
            f"""
            MERGE INTO {self.bronze_table} t
            USING traffic_bronze_batch s
            ON  t.topic = s.topic
            AND t.partition = s.partition
            AND t.offset = s.offset
            WHEN NOT MATCHED THEN
              INSERT *
            """
        )

    def save(self, bronze_df):
        return (
            bronze_df.writeStream.queryName("traffic-bronze")
            .foreachBatch(self.upsert)
            .option("checkpointLocation", self.checkpoint)
            .outputMode("append")
            .start()
        )

    def process(self):
        print("Starting Traffic Bronze stream...", end="")
        raw_df = self.ingestFromSourceTable()
        bronze_df = self.normalize(raw_df)
        q = self.save(bronze_df)
        print("Done")
        return q