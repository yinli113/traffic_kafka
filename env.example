# Copy to .env and fill in values. Do NOT commit .env.
#
#   cp env.example .env
#

# Kafka (local)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Victoria Bluetooth Travel Time API
VIC_API_KEY=PASTE_YOUR_KEY_VALUE
VIC_API_KEY_HEADER=KeyId
VIC_API_KEY_PREFIX=
VIC_API_URL=https://api.opendata.transport.vic.gov.au/opendata/roads/bluetooth-travel-time/v1/links/3

# Optional: poll multiple links per interval
VIC_API_BASE_URL=https://api.opendata.transport.vic.gov.au/opendata/roads/bluetooth-travel-time/v1
VIC_LINK_IDS=3,9

